{
  "redirects": [
    {
      "source": "/academy/learn.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<course>[^/]+)"
        },
        {
          "type": "query",
          "key": "l",
          "value": "(?<lesson>[^/]+)"
        }
      ],
      "destination": "/academy/:course/learn/:lesson",
      "permanent": true
    },
    {
      "source": "/academy/learn.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<course>[^/]+)"
        }
      ],
      "destination": "/academy/:course/learn",
      "permanent": true
    },
    {
      "source": "/academy/course.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<course>[^/]+)"
        }
      ],
      "destination": "/academy/:course",
      "permanent": true
    },
    {
      "source": "/academy/pay.html",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "(?<course>[^/]+)"
        }
      ],
      "destination": "/academy/:course/pay",
      "permanent": true
    },
    {
      "source": "/academy/certificate.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<cert>[^/]+)"
        }
      ],
      "destination": "/academy/certificate/:cert",
      "permanent": true
    },
    {
      "source": "/academy/certificate.html",
      "destination": "/academy/certificate",
      "permanent": true
    },
    {
      "source": "/academy/my.html",
      "destination": "/academy/my-learning",
      "permanent": true
    },
    {
      "source": "/academy/course.html",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/academy/learn.html",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/academy/pay.html",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/learn.html",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:folder/index.html",
      "destination": "/:folder/",
      "permanent": true
    },
    {
      "source": "/courses",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/courses/",
      "destination": "/academy/",
      "permanent": true
    },
    {
      "source": "/courses/:path*",
      "destination": "/academy/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/academy/my-learning",
      "destination": "/academy/my.html"
    },
    {
      "source": "/academy/certificate",
      "destination": "/academy/certificate.html"
    },
    {
      "source": "/academy/certificate/:id",
      "destination": "/academy/certificate.html"
    },
    {
      "source": "/academy/:course/learn/:lesson",
      "destination": "/academy/learn.html"
    },
    {
      "source": "/academy/:course/learn",
      "destination": "/academy/learn.html"
    },
    {
      "source": "/academy/:course/pay",
      "destination": "/academy/pay.html"
    },
    {
      "source": "/academy/:course",
      "destination": "/academy/course.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.vercel-insights.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://muaxisgstxpoyfhzdgcm.supabase.co wss://muaxisgstxpoyfhzdgcm.supabase.co https://www.youtube.com https://vimeo.com https://vitals.vercel-insights.com https://cdn.vercel-insights.com https://va.vercel-scripts.com https://*.livekit.cloud wss://*.livekit.cloud; frame-src https://*.daily.co https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://drive.google.com https://docs.google.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://*.daily.co\"), microphone=(self \"https://*.daily.co\"), display-capture=(self \"https://*.daily.co\"), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
